# Copy to .env.production (or set in your build environment) before running
# `npm run build --workspace=frontend`. Vite inlines these at build time, so a
# build made without them ships with analytics fully disabled — no script
# request, no events. That is the intended state for local development.

VITE_API_URL=
VITE_SOCKET_URL=

# Umami. Both must be set or the tracker is never loaded.
# Script URL is your Umami instance + /script.js
VITE_UMAMI_SCRIPT_URL=https://stats.cinezoo.tv/script.js
# UUID shown under Settings -> Websites -> Edit after you add cinezoo.tv
VITE_UMAMI_WEBSITE_ID=
